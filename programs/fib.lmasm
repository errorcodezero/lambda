/ Fibonacci test: computes F(n) iteratively.
/ Equivalent to test_fib() in test.c.
/ Expected result: R0 = 0x37 (55 = F(10)), R1 = 0x59 (89 = F(11))

#data

#text

[start] {0} ()
/ LDI R0, 0 (4 bytes: 32 00 00 00)  -- fib n-2
@LDI 0x00 0x0000

/ LDI R1, 1 (4 bytes: 32 01 01 00)  -- fib n-1
@LDI 0x01 0x0001

/ LDI R2, 10 (4 bytes: 32 02 0A 00) -- loop counter
@LDI 0x02 0x000A

/ --- loop_start (address 0x01000C) ---

/ ADDRR R3, R0, R1 (3 bytes: 2A SR RR)
/   SR = 0x03: S=0 (no carry), R=R3 (destination)
/   RR = 0x01: RX=R0 (first source), RY=R1 (second source)
/   R3 = R0 + R1  (next Fibonacci number)
@ADDRR 0x03 0x01

/ ADDI R0, R1, 0 (4 bytes: 30 RR II II)
/   RR = 0x01: (dest=R0 << 4) | src=R1
/   II = 0x0000: immediate = 0
/   R0 = R1  (shift n-2 to n-1 position)
@ADDI 0x01 0x0000

/ ADDI R1, R3, 0 (4 bytes: 30 13 00 00)
/   RR = 0x13: (dest=R1 << 4) | src=R3
/   R1 = R3  (new fib number becomes n-1)
@ADDI 0x13 0x0000

/ DEC R2, 1 (2 bytes: 11 21)
/   byte 1: 0x21 = (R2 << 4) | 1  -> decrement counter
@DEC 0x21

/ AJMPIGD to 0x01000C (loop_start) while counter > 0
@AJMPIGD 0x01000C

/ HLT
@HLT
[/start]
